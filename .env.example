# Public Supabase keys (safe for the browser — protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Vercel serverless API (same values — set in Vercel dashboard)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Bot Postgres (Neon) — server-side only, NEVER expose to frontend
DATABASE_URL=postgresql://...

# n8n supervisor webhook — server-side only
SUPERVISOR_WEBHOOK_SECRET=your-secret-here
N8N_SUPERVISOR_WEBHOOK_URL=https://n8n.esteemmediaa.com/webhook/tasami-supervisor-reply

# Optional — Telegram/n8n notify on new website orders
# VITE_ORDER_NOTIFY_URL=https://n8n.esteemmediaa.com/webhook/tasami-website-order
# VITE_QUOTE_NOTIFY_URL=https://n8n.esteemmediaa.com/webhook/tasami-website-quote

# Moyasar (Phase 2) — publishable is safe in browser; secret is server-only
# VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_xxx
# MOYASAR_SECRET_KEY=sk_test_xxx
# MOYASAR_WEBHOOK_SECRET=whsec_xxx

# Optional — local setup scripts only (NEVER commit, NEVER put in Vite/frontend)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
# SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=strong-password-here
