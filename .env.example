# Public Supabase keys (safe for the browser — protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Vercel serverless API (same values — set in Vercel dashboard)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Bot Postgres (Neon) — server-side only, NEVER expose to frontend
DATABASE_URL=postgresql://...

# n8n supervisor webhook — server-side only
SUPERVISOR_WEBHOOK_SECRET=your-secret-here
N8N_SUPERVISOR_WEBHOOK_URL=https://n8n.esteemmediaa.com/webhook/tasami-supervisor-reply

# Optional — local setup scripts only (NEVER commit)
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
# SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=strong-password-here
